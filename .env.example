# Supabase 연결 (필수)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kakao 지도 (장소 검색에 사용)
NEXT_PUBLIC_KAKAO_JS_KEY=

# 앱 공유 링크용 기본 URL
NEXT_PUBLIC_APP_URL=https://how-many-mauve.vercel.app

# Android (Capacitor) 빌드 전용 — dev 빌드 시 shell에서 주입
# 사용법: CAPACITOR_SERVER_URL=https://how-many-git-develop-xxx.vercel.app npm run build:android:dev
# 미설정 시 capacitor.config.ts가 프로덕션 URL로 fallback
# CAPACITOR_SERVER_URL=
